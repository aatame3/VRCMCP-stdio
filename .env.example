# VRChat account credentials (required)
VRCHAT_USERNAME=your_vrchat_username_or_email
VRCHAT_PASSWORD=your_vrchat_password

# TOTP secret for automatic 2FA (optional)
# Find this in your authenticator app settings when setting up 2FA
# e.g. ABCDEFGHIJKLMNOP234567ABCDEFGHIJ
VRCHAT_TOTP_SECRET=

# Gemini API key for AI-powered fuzzy friend search (optional)
# Get yours at https://aistudio.google.com/apikey
GEMINI_API_KEY=
